---
import { render, type CollectionEntry } from 'astro:content';
import { entriesLabel, type Game } from '../lib/games';
import { downloadFor } from '../lib/download';
import { gameTitle } from '../lib/seo';
import Keyart from './Keyart.astro';
import Icon from './Icon.astro';

interface Props {
  game: Game;
  doc?: CollectionEntry<'gameDocs'>;
  /** Panel already open in the HTML on /<slug>/: the game title is then the page heading. */
  active?: boolean;
}

const { game, doc, active = false } = Astro.props;
const Title = active ? 'h1' : 'h2';
const download = downloadFor(game);
const stores = Object.entries(game.stores);

const REPO = 'https://github.com/Veatec22/notgeese';
const STORE_NAMES: Record<string, string> = { steam: 'Steam', gog: 'GOG', epic: 'Epic', itch: 'itch.io' };
const storeName = (store: string) => STORE_NAMES[store.toLowerCase()] ?? store;
const hasLogo = (store: string) => ['steam', 'gog'].includes(store.toLowerCase());
const rendered = doc ? await render(doc) : null;
const Content = rendered?.Content;
---

<div class="ng-panel-scroll" data-game={game.slug} data-page-title={gameTitle(game.title)} hidden={!active}>
  <Keyart game={game} variant="panel" />

  <div class="ng-panel-body">
    <div>
      <div class="ng-panel-head" style={`--ng-title-len: ${game.title.length}; --ng-stores: ${stores.length}`}>
        <Title class="ng-display ng-panel-title"><span class="ng-visually-hidden">Spolszczenie </span>{game.title}</Title>
        {
          stores.length > 0 && (
            <div class="ng-panel-stores">
              {stores.map(([store, url]) => (
                <a class="ng-btn ng-btn--compact" href={url} target="_blank" rel="noopener">
                  {hasLogo(store) && <Icon name={store.toLowerCase() as 'steam' | 'gog'} size={20} />}
                  {storeName(store)}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <div class="ng-panel-status" style="margin-top: var(--ng-space-4)">
        <span class="ng-status">
          <button
            class="ng-badge ng-badge--lg ng-status-trigger"
            type="button"
            data-tone={game.status.tone}
            aria-describedby={`status-${game.slug}`}
          >
            {game.status.label}
            <Icon name="info" size={18} />
          </button>
          <span class="ng-status-tip" role="tooltip" id={`status-${game.slug}`}>{game.status.description}</span>
        </span>
        <span class="ng-badge-note">v{game.version}</span>
      </div>
    </div>

    {
      game.quote?.text && (
        <figure class="ng-quote" style="margin: 0">
          <span class="ng-quote-mark" aria-hidden="true">„</span>
          <p>{game.quote.text}</p>
          {game.quote.source && <cite>{game.quote.source}</cite>}
        </figure>
      )
    }

    <div class="ng-panel-actions">
      <div class="ng-panel-actions-row">
        {
          download.available ? (
            <a class="ng-btn ng-btn--primary ng-btn--download ng-on-accent" href={download.href} download>
              <Icon name="download" />
              <span>Pobierz spolszczenie</span>
              {download.meta && <span class="ng-btn-meta">{download.meta}</span>}
            </a>
          ) : (
            <span class="ng-btn ng-btn--primary ng-btn--download" aria-disabled="true">
              {download.label}
            </span>
          )
        }
        <a
          class="ng-btn ng-btn--square"
          href={`${REPO}/tree/main/games/${game.slug}`}
          target="_blank"
          rel="noopener"
          aria-label="Pliki spolszczenia na GitHubie"
          title="Pliki spolszczenia na GitHubie"
        >
          <Icon name="github" />
        </a>
      </div>
    </div>

    <table class="ng-table">
      <tbody>
        <tr><th>Zakres</th><td>{entriesLabel(game)} — {game.scope}</td></tr>
        <tr><th>Sposób</th><td>{game.approach}</td></tr>
        {
          game.tested_on.length > 0 && (
            <tr>
              <th>Przetestowana wersja</th>
              <td>
                {game.tested_on.map((tested, index) => (
                  <>
                    {index > 0 && <br />}
                    <strong>{tested.version}</strong> · {storeName(tested.store)}
                  </>
                ))}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>

    {
      Content && (
        <div class="ng-prose ng-prose--panel">
          <Content />
        </div>
      )
    }
  </div>
</div>

---
import { COVER_SIZE, SHOT_SIZE, keyartFor, type Art } from '../lib/keyart';
import type { Game } from '../lib/games';
import Icon from './Icon.astro';

interface Props {
  game: Game;
  variant: 'card' | 'panel';
}

const { game, variant } = Astro.props;
const art = keyartFor(game.slug, game.gallery);

// On-screen image width: tile in a 1–3 column grid, panel up to 800 px.
const CARD_SIZES = '(max-width: 699px) calc(100vw - 40px), (max-width: 1279px) 50vw, 420px';
const PANEL_SIZES = '(max-width: 699px) 100vw, min(800px, 92vw)';

// The tile shows the cover, or the first screenshot when there is none. Panel: cover plus full gallery.
const cardArt = art ? (art.cover ?? art.shots[0]) : null;
const slides: { art: Art; size: typeof COVER_SIZE }[] = art
  ? [
      ...(art.cover ? [{ art: art.cover, size: COVER_SIZE }] : []),
      ...art.shots.map((shot) => ({ art: shot, size: SHOT_SIZE })),
    ]
  : [];
---

{
  variant === 'card' ? (
    <div class="ng-card-art" data-tone={game.tone}>
      {cardArt ? (
        <picture>
          <source type="image/avif" srcset={cardArt.avif} sizes={CARD_SIZES} />
          <source type="image/webp" srcset={cardArt.webp} sizes={CARD_SIZES} />
          <img
            src={cardArt.src}
            alt=""
            width={art!.cover ? COVER_SIZE.width : SHOT_SIZE.width}
            height={art!.cover ? COVER_SIZE.height : SHOT_SIZE.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      ) : (
        <>
          <span class="ng-label ng-card-art-label">[keyart]</span>
          <span class="ng-card-art-initial" aria-hidden="true">
            {game.title.charAt(0)}
          </span>
        </>
      )}
    </div>
  ) : slides.length > 0 ? (
    <section class="ng-panel-art ng-carousel" data-tone={game.tone} data-carousel aria-roledescription="karuzela"
      aria-label={`Grafiki z ${game.title}`}>
      {/* Without JS a plain horizontal scroller; the script adds arrows, markers and keyboard. */}
      <ul class="ng-carousel-track" data-carousel-track tabindex="0">
        {slides.map((slide, index) => (
          <li class="ng-carousel-slide" aria-roledescription="slajd" aria-label={`${index + 1} z ${slides.length}`}>
            <picture>
              <source type="image/avif" srcset={slide.art.avif} sizes={PANEL_SIZES} />
              <source type="image/webp" srcset={slide.art.webp} sizes={PANEL_SIZES} />
              {/* All game panels are in the HTML from the start, hidden; lazy does not fetch them early. */}
              <img
                src={slide.art.src}
                alt={`${game.title} — ${index === 0 && art!.cover ? 'okładka' : `zrzut ekranu ${index + (art!.cover ? 0 : 1)}`}`}
                width={slide.size.width}
                height={slide.size.height}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </picture>
          </li>
        ))}
      </ul>
      {slides.length > 1 && (
        <div class="ng-carousel-controls" data-carousel-controls hidden>
          <button class="ng-carousel-arrow" type="button" data-carousel-prev aria-label="Poprzednia grafika">
            <Icon name="chevron-left" />
          </button>
          <div class="ng-carousel-marks" aria-hidden="true">
            {slides.map(() => <span class="ng-carousel-mark" />)}
          </div>
          <button class="ng-carousel-arrow" type="button" data-carousel-next aria-label="Następna grafika">
            <Icon name="chevron-right" />
          </button>
        </div>
      )}
    </section>
  ) : (
    <div class="ng-panel-art" data-tone={game.tone}>
      <span class="ng-label ng-card-art-label">[keyart]</span>
      <span class="ng-card-art-initial" aria-hidden="true">
        {game.title.charAt(0)}
      </span>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')!;
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
    if (!controls) return;

    const slides = Array.from(track.children) as HTMLElement[];
    const marks = Array.from(controls.querySelectorAll<HTMLElement>('.ng-carousel-mark'));
    const prev = controls.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    controls.hidden = false;

    const current = () => (track.clientWidth ? Math.round(track.scrollLeft / track.clientWidth) : 0);
    const go = (index: number) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: target * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };
    const update = () => {
      const index = current();
      marks.forEach((mark, i) => mark.toggleAttribute('data-active', i === index));
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };

    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      const moves: Record<string, number> = { ArrowLeft: current() - 1, ArrowRight: current() + 1, Home: 0, End: slides.length - 1 };
      if (!(event.key in moves)) return;
      event.preventDefault();
      go(moves[event.key]!);
    });
    update();
  });
</script>

---
// Workspace. The HTML carries only public game metadata; game texts are fetched
// after login by an Edge Function from main. Out of the sitemap, noindex.
import Header from '../../components/Header.astro';
import '../../styles/tokens.css';
import '../../styles/global.css';
import '../../workspace/workspace.css';
import { getGames } from '../../lib/games';
import { withBase } from '../../lib/url';

const games = (await getGames()).map((game) => ({
  slug: game.slug,
  title: game.title,
  version: game.version,
  entries: game.entries.total,
}));
const data = JSON.stringify(games).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Pracownia korekty | Not Geese</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('ng-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="ng-shell"><Header /></div>
    <main id="workspace" aria-live="polite"><p class="ws-muted">Wczytywanie pracowni…</p></main>
    <div id="ws-toast" role="status" aria-live="polite"></div>
    <dialog id="ws-dialog" aria-labelledby="ws-dialog-title"></dialog>
    <script id="ws-games" type="application/json" set:html={data} />
    <script>
      import '../../workspace/app.ts';
    </script>
  </body>
</html>
